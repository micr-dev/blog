# Newsletter (Resend). Copy to .env.local for local runs and set the same
# four variables in the Vercel project settings for production.

# API key from https://resend.com/api-keys. Needs Full access, because the
# newsletter both writes contacts and creates broadcasts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The segment confirmed subscribers are added to, and the segment broadcasts
# are sent to. Create it once at https://resend.com/audience and copy its id.
RESEND_SEGMENT_ID=00000000-0000-0000-0000-000000000000

# Sender for both the confirmation email and the post announcements. The domain
# has to be verified at https://resend.com/domains first.
NEWSLETTER_FROM=Microck <newsletter@micr.dev>

# Signing key for the double opt-in confirmation links. Any long random string.
# Generate one with: openssl rand -base64 32
# Changing it invalidates every confirmation link that has not been clicked yet.
NEWSLETTER_SECRET=replace-me-with-a-long-random-string
